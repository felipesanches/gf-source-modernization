+use crate::{filters::FontFilter, NodeType};
+
+/// A filter that leaves out the on-curve points FontForge's TrueType exporter
+/// leaves out, so the compiler implies them as FontForge did.
+///
+/// FontForge writes a quadratic on-curve point to `glyf` only when it carries a
+/// TrueType point number, or when it is not half-way between its two control
+/// points: a point with no number (an .sfd point written `...,-1,...`) that lies
+/// within 0.1 unit of that midpoint, and is not marked "don't interpolate" or
+/// "round to grid", is omitted, and a TrueType reader interpolates it from the two
+/// ROUNDED control points (tottf.c SSAddPoints, splineutil2.c SPInterpolate). A
+/// compiler that keeps the point rounds it on its own, which can move it by half a
+/// unit from where FontForge's font has it.
+///
+/// A point read without a recorded number (one the .sfd never numbered) is treated
+/// as FontForge's exporter treats it after renumbering: omitted when half-way.
+///
+/// Only quadratic layers are touched.
+#[derive(Default)]
+pub struct FontForgeImpliedOncurves;
+
+impl FontForgeImpliedOncurves {
+    /// Create a new FontForgeImpliedOncurves filter
+    pub fn new() -> Self {
+        FontForgeImpliedOncurves
+    }
+}
+
+/// (flags, ttfindex) from an .sfd point's "flags[,ttfindex,nextcpindex]".
+fn sfd_point(node: &crate::Node) -> (u32, Option<i64>) {
+    let Some(s) = node
+        .format_specific
+        .get("sfd.point_flags")
+        .and_then(|v| v.as_str())
+    else {
+        return (0, None);
+    };
+    let mut it = s.split(',');
+    let flags = it.next().and_then(|f| f.trim().parse().ok()).unwrap_or(0);
+    let ttf = it.next().and_then(|t| t.trim().parse().ok());
+    (flags, ttf)
+}
+
+impl FontFilter for FontForgeImpliedOncurves {
+    fn apply(&self, font: &mut crate::Font) -> Result<(), crate::BabelfontError> {
+        let mut dropped = 0usize;
+        for glyph in font.glyphs.iter_mut() {
+            for layer in &mut glyph.layers {
+                let quadratic = layer
+                    .format_specific
+                    .get("sfd.is_quadratic")
+                    .and_then(|v| v.as_bool())
+                    .unwrap_or(false);
+                if !quadratic {
+                    continue;
+                }
+                for path in layer.shapes.iter_mut().filter_map(|s| s.as_path_mut()) {
+                    if !path.closed {
+                        continue;
+                    }
+                    let n = path.nodes.len();
+                    let mut keep = vec![true; n];
+                    for i in 0..n {
+                        let node = &path.nodes[i];
+                        if !matches!(node.nodetype, NodeType::QCurve) {
+                            continue;
+                        }
+                        let prev = &path.nodes[(i + n - 1) % n];
+                        let next = &path.nodes[(i + 1) % n];
+                        if !matches!(prev.nodetype, NodeType::OffCurve)
+                            || !matches!(next.nodetype, NodeType::OffCurve)
+                        {
+                            continue;
+                        }
+                        let (flags, ttf) = sfd_point(node);
+                        // roundx 0x20, roundy 0x40, dontinterpolate 0x100
+                        if flags & (0x20 | 0x40 | 0x100) != 0 || ttf.is_some_and(|t| t >= 0) {
+                            continue;
+                        }
+                        if (node.x - (prev.x + next.x) / 2.0).abs() <= 0.1
+                            && (node.y - (prev.y + next.y) / 2.0).abs() <= 0.1
+                        {
+                            keep[i] = false;
+                        }
+                    }
+                    // A contour keeps at least one on-curve point.
+                    if keep.iter().zip(path.nodes.iter()).all(|(k, nd)| {
+                        !*k || matches!(nd.nodetype, NodeType::OffCurve)
+                    }) {
+                        continue;
+                    }
+                    let before = path.nodes.len();
+                    let mut i = 0;
+                    path.nodes.retain(|_| {
+                        let k = keep[i];
+                        i += 1;
+                        k
+                    });
+                    dropped += before - path.nodes.len();
+                }
+            }
+        }
+        log::info!("{dropped} on-curve point(s) left for the compiler to imply");
+        Ok(())
+    }
+
+    fn from_str(_s: &str) -> Result<Self, crate::BabelfontError>
+    where
+        Self: Sized,
+    {
+        Ok(FontForgeImpliedOncurves::new())
+    }
+
+    #[cfg(feature = "cli")]
+    fn arg() -> clap::Arg
+    where
+        Self: Sized,
+    {
+        clap::Arg::new("fontforgeimpliedoncurves")
+            .long("fontforge-implied-oncurves")
+            .help(
+                "Leave out the quadratic on-curve points FontForge's TrueType exporter \
+                 leaves out (unnumbered, half-way between their control points), so the \
+                 compiler implies them from the rounded control points",
+            )
+            .action(clap::ArgAction::SetTrue)
+    }
+}
