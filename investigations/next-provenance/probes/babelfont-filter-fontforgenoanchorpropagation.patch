+use crate::filters::FontFilter;
+
+/// A filter that asks a Glyphs compiler not to propagate anchors from components.
+///
+/// FontForge's GPOS export attaches marks to a glyph only through the anchor
+/// points the glyph itself carries (tottfgpos.c walks each glyph's own
+/// `sc->anchor` list); a glyph made only of references has none, and is not a base.
+/// Glyphs, and fontc reading a Glyphs source, copy anchors up from components
+/// unless the font says otherwise, which makes such a glyph a base the exported
+/// font never had. This sets the font-level custom parameter "Propagate Anchors"
+/// to false, which fontc honours.
+#[derive(Default)]
+pub struct FontForgeNoAnchorPropagation;
+
+impl FontForgeNoAnchorPropagation {
+    /// Create a new FontForgeNoAnchorPropagation filter
+    pub fn new() -> Self {
+        FontForgeNoAnchorPropagation
+    }
+}
+
+impl FontFilter for FontForgeNoAnchorPropagation {
+    fn apply(&self, font: &mut crate::Font) -> Result<(), crate::BabelfontError> {
+        font.format_specific.insert(
+            "com.schriftgestalt.Glyphs.customParameters.Propagate Anchors".to_string(),
+            serde_json::json!({ "value": 0, "disabled": false }),
+        );
+        Ok(())
+    }
+
+    fn from_str(_s: &str) -> Result<Self, crate::BabelfontError>
+    where
+        Self: Sized,
+    {
+        Ok(FontForgeNoAnchorPropagation::new())
+    }
+
+    #[cfg(feature = "cli")]
+    fn arg() -> clap::Arg
+    where
+        Self: Sized,
+    {
+        clap::Arg::new("fontforgenoanchorpropagation")
+            .long("fontforge-no-anchor-propagation")
+            .help(
+                "Set the Glyphs custom parameter Propagate Anchors to false: FontForge \
+                 exports a glyph's own anchors only, never its components'",
+            )
+            .action(clap::ArgAction::SetTrue)
+    }
+}
