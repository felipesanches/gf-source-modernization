diff --git a/babelfont/src/filters/fontforgerintcoordinates.rs b/babelfont/src/filters/fontforgerintcoordinates.rs
new file mode 100644
index 0000000..bae437b
--- /dev/null
+++ b/babelfont/src/filters/fontforgerintcoordinates.rs
@@ -0,0 +1,74 @@
+use crate::filters::FontFilter;
+
+/// A filter that rounds the points of TrueType (quadratic) outlines the way
+/// FontForge's TrueType exporter does.
+///
+/// An .sfd can state a point at a half unit (`186.5 0 m`). FontForge writes each
+/// point of a quadratic outline to `glyf` with C's `rint()`, which rounds a half to
+/// the even integer (186.5 -> 186, 187.5 -> 188). A compiler that rounds a half up
+/// writes 187 instead, so the glyph moves by a unit and its left side bearing with
+/// it. Rounding here, before the compiler sees the point, gives the compiler integers
+/// and the exported glyph FontForge's coordinates.
+///
+/// Only layers read as quadratic are rounded: FontForge approximates a cubic
+/// outline before rounding, so its points are not the source's.
+#[derive(Default)]
+pub struct FontForgeRintCoordinates;
+
+impl FontForgeRintCoordinates {
+    /// Create a new FontForgeRintCoordinates filter
+    pub fn new() -> Self {
+        FontForgeRintCoordinates
+    }
+}
+
+impl FontFilter for FontForgeRintCoordinates {
+    fn apply(&self, font: &mut crate::Font) -> Result<(), crate::BabelfontError> {
+        let mut moved = 0usize;
+        for glyph in font.glyphs.iter_mut() {
+            for layer in &mut glyph.layers {
+                let quadratic = layer
+                    .format_specific
+                    .get("sfd.is_quadratic")
+                    .and_then(|v| v.as_bool())
+                    .unwrap_or(false);
+                if !quadratic {
+                    continue;
+                }
+                for path in layer.shapes.iter_mut().filter_map(|s| s.as_path_mut()) {
+                    for node in path.nodes.iter_mut() {
+                        let (x, y) = (node.x.round_ties_even(), node.y.round_ties_even());
+                        if x != node.x.round() || y != node.y.round() {
+                            moved += 1;
+                        }
+                        node.x = x;
+                        node.y = y;
+                    }
+                }
+            }
+        }
+        log::info!("{moved} point(s) rounded to even where rounding half up would differ");
+        Ok(())
+    }
+
+    fn from_str(_s: &str) -> Result<Self, crate::BabelfontError>
+    where
+        Self: Sized,
+    {
+        Ok(FontForgeRintCoordinates::new())
+    }
+
+    #[cfg(feature = "cli")]
+    fn arg() -> clap::Arg
+    where
+        Self: Sized,
+    {
+        clap::Arg::new("fontforgerintcoordinates")
+            .long("fontforge-rint-coordinates")
+            .help(
+                "Round the points of quadratic outlines half to even, as FontForge's \
+                 TrueType exporter does (C rint)",
+            )
+            .action(clap::ArgAction::SetTrue)
+    }
+}
