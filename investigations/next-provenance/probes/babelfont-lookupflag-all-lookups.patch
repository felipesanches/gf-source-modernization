+            // A lookup that is not contextual keeps its flags as well. FontForge
+            // writes them into the font; without IgnoreMarks, for example, a
+            // lam-alef ligature no longer forms across a haraka.
+            if !has_chain && !lookup.block.statements.is_empty() {
+                if lookup.flag & !0x000F != 0 {
+                    log::warn!(
+                        "lookup {:?}: flag {:#06x} carries bits (mark-attachment \
+                         class or filtering set) that are not converted",
+                        lookup.block.name,
+                        lookup.flag
+                    );
+                }
+                if lookup.flag & 0x000F != 0 {
+                    lookup.block.statements.insert(
+                        0,
+                        fea_rs_ast::Statement::LookupFlag(fea_rs_ast::LookupFlagStatement::new(
+                            lookup.flag & 0x000F,
+                            None,
+                            None,
+                            0..0,
+                        )),
+                    );
+                }
+            }
             if lookup.block.statements.is_empty() {
                 // No statements: skip this lookup
                 continue;
