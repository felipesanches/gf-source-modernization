+/// The `script` and `language` statements that register the next lookup for one
+/// language system.
+///
+/// A FontForge lookup names every script and language it applies to, and nothing
+/// is inherited: a lookup registered for `latn/dflt` and not for `latn/TRK` does
+/// not run for Turkish. In a feature file a `language` statement inherits the
+/// lookups already registered for the script's default language unless it says
+/// `exclude_dflt`, so a language other than `dflt` excludes them here.
 pub(crate) fn make_langsys(script: SmolStr, language: SmolStr) -> Vec<fea_rs_ast::Statement> {
+    let include_dflt = language == "dflt";
     vec![
         fea_rs_ast::Statement::Script(fea_rs_ast::ScriptStatement::new(script.into())),
         fea_rs_ast::Statement::Language(fea_rs_ast::LanguageStatement::new(
             language.into(),
-            true,
+            include_dflt,
             false,
         )),
     ]
