+use crate::filters::FontFilter;
+
+#[derive(Default)]
+/// A filter that drops the `fsSelection` bits a FontForge before tag 20150824 did not
+/// write because the source pinned an older OS/2 table version.
+///
+/// `USE_TYPO_METRICS` (bit 7), `WWS` (bit 8) and `OBLIQUE` (bit 9) are defined from
+/// OS/2 version 4 on, and FontForge writes them only into a version 4 table. A
+/// source's nonzero `OS2Version` chooses that version. Up to tag 20141230 it replaced
+/// the computed version (`if (sf->os2_version!=0) os2->version = sf->os2_version;`
+/// in `fontforge/tottf.c`, `setos2()`), so `OS2Version: 2` with
+/// `OS2_UseTypoMetrics: 1` gave a version 2 table without bit 7. From tag 20150824
+/// on, FontForge keeps the larger of the two versions, and the same source gives a
+/// version 4 table with bit 7, which is what the SFD reader produces.
+///
+/// This filter applies the older rule: when the source states an `OS2Version` from 1
+/// to 3, it clears bits 7 and 8. The OS/2 version itself is not carried, because the
+/// compiler chooses it.
+///
+/// It is opt-in: the rule depends on the FontForge that exported the binary.
+pub struct FontForgeLegacyOs2Version;
+
+impl FontForgeLegacyOs2Version {
+    /// Create a new FontForgeLegacyOs2Version filter
+    pub fn new() -> Self {
+        FontForgeLegacyOs2Version
+    }
+}
+
+/// The bits FontForge writes only into a version 4 table and the SFD reader sets:
+/// `USE_TYPO_METRICS` (7) and `WWS` (8).
+const VERSION_4_BITS: u16 = (1 << 7) | (1 << 8);
+
+impl FontFilter for FontForgeLegacyOs2Version {
+    fn apply(&self, font: &mut crate::Font) -> Result<(), crate::BabelfontError> {
+        let version = font
+            .format_specific
+            .get("OS2Version")
+            .and_then(|v| v.as_str())
+            .and_then(|v| v.trim().parse::<u16>().ok())
+            .unwrap_or(0);
+        if !(1..4).contains(&version) {
+            return Ok(());
+        }
+        if let Some(selection) = font.custom_ot_values.os2_fs_selection {
+            let kept = selection & !VERSION_4_BITS;
+            if kept != selection {
+                log::info!(
+                    "Cleared fsSelection bits {:#06x}: the source pins OS/2 version {version}, \
+                     and a FontForge before tag 20150824 wrote them only into version 4",
+                    selection & VERSION_4_BITS
+                );
+            }
+            font.custom_ot_values.os2_fs_selection = Some(kept);
+        }
+        Ok(())
+    }
+
+    fn from_str(_s: &str) -> Result<Self, crate::BabelfontError>
+    where
+        Self: Sized,
+    {
+        Ok(FontForgeLegacyOs2Version::new())
+    }
+
+    #[cfg(feature = "cli")]
+    fn arg() -> clap::Arg
+    where
+        Self: Sized,
+    {
+        clap::Arg::new("fontforgelegacyos2version")
+            .long("fontforge-legacy-os2-version")
+            .help(
+                "Clear fsSelection bits 7 (USE_TYPO_METRICS) and 8 (WWS) when a FontForge \
+                 source states an OS2Version from 1 to 3. Up to tag 20141230 FontForge's \
+                 exporter used that version as stated, and these bits exist only from \
+                 version 4; from tag 20150824 it raises the version to 4. Use only to \
+                 reproduce a binary an older FontForge exported",
+            )
+            .action(clap::ArgAction::SetTrue)
+    }
+}
+
+#[allow(clippy::unwrap_used, clippy::expect_used)]
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Font;
+
+    fn font_with(version: Option<&str>, selection: Option<u16>) -> Font {
+        let mut font = Font::new();
+        if let Some(v) = version {
+            font.format_specific
+                .insert("OS2Version".to_string(), serde_json::Value::String(v.into()));
+        }
+        font.custom_ot_values.os2_fs_selection = selection;
+        font
+    }
+
+    #[test]
+    fn test_a_pinned_version_below_4_drops_bits_7_and_8() {
+        let mut font = font_with(Some("2"), Some(0x40 | 0x80 | 0x100));
+        FontForgeLegacyOs2Version::new().apply(&mut font).unwrap();
+        assert_eq!(font.custom_ot_values.os2_fs_selection, Some(0x40));
+    }
+
+    #[test]
+    fn test_version_0_and_4_are_left_alone() {
+        for v in ["0", "4"] {
+            let mut font = font_with(Some(v), Some(0x80));
+            FontForgeLegacyOs2Version::new().apply(&mut font).unwrap();
+            assert_eq!(font.custom_ot_values.os2_fs_selection, Some(0x80));
+        }
+        let mut font = font_with(None, Some(0x80));
+        FontForgeLegacyOs2Version::new().apply(&mut font).unwrap();
+        assert_eq!(font.custom_ot_values.os2_fs_selection, Some(0x80));
+    }
+}
