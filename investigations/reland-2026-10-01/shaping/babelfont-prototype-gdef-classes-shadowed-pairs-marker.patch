diff --git a/babelfont/src/filters/fontforgegdefclasses.rs b/babelfont/src/filters/fontforgegdefclasses.rs
new file mode 100644
index 00000000..a17b5188
--- /dev/null
+++ b/babelfont/src/filters/fontforgegdefclasses.rs
@@ -0,0 +1,115 @@
+use crate::features::PossiblyAutomaticCode;
+use crate::filters::FontFilter;
+
+/// A filter that states a FontForge source's GDEF glyph classes explicitly, as
+/// FontForge's OpenType exporter wrote them.
+///
+/// FontForge (`tottfgpos.c`, `otf_dumpgdef()`) writes a GDEF GlyphClassDef that
+/// classes every glyph: an explicit `GlyphClass` wins; otherwise `.notdef` gets no
+/// class, a glyph whose first non-cursive anchor is a mark (or mark-to-mark) anchor
+/// is a mark, a glyph that a ligature substitution produces is a ligature, and
+/// everything else is a base (`gdefclass()`). Any glyph with an explicit class, or
+/// with a class other than base -- `.notdef` alone is enough -- makes it write the
+/// table, so every OpenType-mode export carries one. A combining accent that the
+/// source does not class therefore ships as a base, keeps its advance and is not
+/// skipped by lookups that ignore marks.
+///
+/// A Glyphs source cannot say "base" for a glyph without anchors: compilers that
+/// follow glyphsLib (fontc included) class a glyph as a base only when it has an
+/// attaching anchor, and take a mark class from the glyph's name when the source
+/// gives no category. So this filter writes the classes the SFD reader recorded
+/// (`sfd.gdef_class`) as a `table GDEF { GlyphClassDef ... } GDEF;` feature prefix,
+/// which compilers use instead of the ones they would infer.
+///
+/// It is opt-in: the explicit table fixes the classes, so glyphs added to the
+/// converted source later have to be added to it by hand. A binary that FontForge
+/// did not export, or exported with OpenType tables off (an old `kern` table and no
+/// GDEF), has other classes or none.
+#[derive(Default)]
+pub struct FontForgeGdefClasses;
+
+impl FontForgeGdefClasses {
+    /// Create a new FontForgeGdefClasses filter
+    pub fn new() -> Self {
+        FontForgeGdefClasses
+    }
+}
+
+impl FontFilter for FontForgeGdefClasses {
+    fn apply(&self, font: &mut crate::Font) -> Result<(), crate::BabelfontError> {
+        // base, ligature, mark, component: the four slots of GlyphClassDef
+        let mut classes: [Vec<&str>; 4] = Default::default();
+        let mut recorded = 0;
+        for glyph in font.glyphs.iter() {
+            if !glyph.exported {
+                continue;
+            }
+            let Some(class) = glyph
+                .format_specific
+                .get("sfd.gdef_class")
+                .and_then(|v| v.as_u64())
+            else {
+                continue;
+            };
+            recorded += 1;
+            if (1..=4).contains(&class) {
+                classes[class as usize - 1].push(glyph.name.as_str());
+            }
+        }
+        if recorded == 0 {
+            log::warn!("No FontForge glyph classes were recorded; not writing a GDEF table");
+            return Ok(());
+        }
+        let slot = |names: &Vec<&str>| {
+            if names.is_empty() {
+                String::new()
+            } else {
+                format!("[{}]", names.join(" "))
+            }
+        };
+        let code = format!(
+            "table GDEF {{\n    GlyphClassDef {}, {}, {}, {};\n}} GDEF;",
+            slot(&classes[0]),
+            slot(&classes[1]),
+            slot(&classes[2]),
+            slot(&classes[3])
+        );
+        font.features.prefixes.insert(
+            "FontForgeGlyphClasses".into(),
+            PossiblyAutomaticCode {
+                code,
+                ..Default::default()
+            },
+        );
+        log::info!(
+            "Wrote FontForge's GDEF glyph classes: {} base, {} ligature, {} mark",
+            classes[0].len(),
+            classes[1].len(),
+            classes[2].len()
+        );
+        Ok(())
+    }
+
+    fn from_str(_s: &str) -> Result<Self, crate::BabelfontError>
+    where
+        Self: Sized,
+    {
+        Ok(FontForgeGdefClasses::new())
+    }
+
+    #[cfg(feature = "cli")]
+    fn arg() -> clap::Arg
+    where
+        Self: Sized,
+    {
+        clap::Arg::new("fontforgegdefclasses")
+            .long("fontforge-gdef-classes")
+            .help(
+                "Write a FontForge source's GDEF glyph classes as FEA, the way FontForge's \
+                 OpenType exporter classed them (explicit GlyphClass, else mark by anchor, \
+                 ligature by substitution, base otherwise); use only for a binary FontForge \
+                 exported with OpenType tables",
+            )
+            .action(clap::ArgAction::SetTrue)
+    }
+}
