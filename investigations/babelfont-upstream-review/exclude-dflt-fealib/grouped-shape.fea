languagesystem latn dflt;
languagesystem latn DEU;
languagesystem latn TRK;
lookup fi { sub f i by f_i; } fi;
lookup ff { sub f f by f_f; } ff;
feature liga {
    script latn;
    language DEU exclude_dflt;
    lookup fi;
    lookup ff;
    script latn;
    language dflt;
    lookup fi;
    lookup ff;
    script latn;
    language TRK exclude_dflt;
    lookup ff;
} liga;
