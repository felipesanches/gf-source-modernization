             &plan,
             context.compile_debg,
+            context.flags.contains(Flags::SHARED_LAYOUT_SCRIPTS),
         )?;
         if plan.gdef && result.gdef_classes.is_none() && !gdef_categories.categories.is_empty() {
             // the FEA did not contain an explicit GDEF block with glyph categories,
diff --git a/fontc/src/args.rs b/fontc/src/args.rs
index 9be507ec..3f3cf849 100644
--- a/fontc/src/args.rs
+++ b/fontc/src/args.rs
@@ -105,6 +105,12 @@ pub struct Args {
     #[arg(long, default_value = "false")]
     pub no_production_names: bool,
 
+    /// List the same scripts in GSUB and GPOS, and write a table that has
+    /// scripts but no features instead of omitting it, as Microsoft VOLT and
