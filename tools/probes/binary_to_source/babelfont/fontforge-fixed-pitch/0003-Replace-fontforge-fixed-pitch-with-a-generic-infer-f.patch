+use crate::filters::monospace::monospaced_advance;
+use crate::filters::FontFilter;
+
+#[derive(Default)]
+/// A filter that marks a monospaced font as fixed pitch (`post.isFixedPitch`)
+/// when the font does not say whether it is.
+///
+/// A font is monospaced when all its exported glyphs have one advance in every
+/// master. Glyphs whose advance says nothing about the spacing of text are left
+/// out: glyphs with a zero advance (such as combining marks), `.notdef`, and the
+/// control-character glyphs `.null` and `nonmarkingreturn` (or any glyph mapped
+/// to U+0000 or U+000D).
+///
+/// Many sources do not state the flag, and a compiler that is not told writes 0,
+/// so a monospaced font would be marked proportional. A font with more than one
+/// advance, or one that already states a value, is left as it is.
+pub struct InferFixedPitch;
+
+impl InferFixedPitch {
+    /// Create a new InferFixedPitch filter
+    pub fn new() -> Self {
+        InferFixedPitch
+    }
+}
+
+impl FontFilter for InferFixedPitch {
+    fn apply(&self, font: &mut crate::Font) -> Result<(), crate::BabelfontError> {
+        if font.custom_ot_values.post_is_fixed_pitch.is_some() {
+            return Ok(());
+        }
+        if let Some(advance) = monospaced_advance(font) {
+            font.custom_ot_values.post_is_fixed_pitch = Some(true);
+            log::info!("Marked the font fixed pitch: every glyph advances {advance}");
+        }
+        Ok(())
+    }
+
+    fn from_str(_s: &str) -> Result<Self, crate::BabelfontError>
+    where
+        Self: Sized,
+    {
+        Ok(InferFixedPitch::new())
+    }
+
+    #[cfg(feature = "cli")]
+    fn arg() -> clap::Arg
+    where
+        Self: Sized,
+    {
+        clap::Arg::new("inferfixedpitch")
+            .long("infer-fixed-pitch")
+            .help(
+                "Set post.isFixedPitch when the font does not state it and all its glyphs \
+                 share one advance (ignoring zero-width glyphs, .notdef, .null and \
+                 nonmarkingreturn)",
+            )
+            .action(clap::ArgAction::SetTrue)
+    }
+}
+
+#[allow(clippy::unwrap_used, clippy::expect_used)]
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Font, Glyph, Layer, LayerType, Master};
+
+    fn font() -> Font {
+        let mut f = Font::new();
+        f.masters.push(Master::default());
+        f
+    }
+
+    fn add_glyph(f: &mut Font, name: &str, advance: f32) {
+        let mut layer = Layer::new(advance);
+        layer.master = LayerType::DefaultForMaster(f.masters[0].id.clone());
+        let mut glyph = Glyph::new(name);
+        glyph.exported = true;
+        glyph.layers.push(layer);
+        f.glyphs.push(glyph);
+    }
+
+    #[test]
+    fn test_one_shared_advance_marks_the_font_fixed_pitch() {
+        let mut f = font();
+        add_glyph(&mut f, "a", 1150.0);
+        add_glyph(&mut f, "b", 1150.0);
+        // Left out: a zero-width mark and a .notdef of another advance.
+        add_glyph(&mut f, "acutecomb", 0.0);
+        add_glyph(&mut f, ".notdef", 500.0);
+        InferFixedPitch::new().apply(&mut f).unwrap();
+        assert_eq!(f.custom_ot_values.post_is_fixed_pitch, Some(true));
+    }
+
+    #[test]
+    fn test_two_advances_leave_the_font_alone() {
+        let mut f = font();
+        add_glyph(&mut f, "a", 1150.0);
+        add_glyph(&mut f, "b", 600.0);
+        InferFixedPitch::new().apply(&mut f).unwrap();
+        assert_eq!(f.custom_ot_values.post_is_fixed_pitch, None);
+    }
+
+    #[test]
+    fn test_a_stated_value_is_kept() {
+        let mut f = font();
+        add_glyph(&mut f, "a", 1150.0);
+        f.custom_ot_values.post_is_fixed_pitch = Some(false);
+        InferFixedPitch::new().apply(&mut f).unwrap();
+        assert_eq!(f.custom_ot_values.post_is_fixed_pitch, Some(false));
+    }
+
+    #[test]
+    fn test_the_glyphs_source_carries_is_fixed_pitch() {
+        let mut f = font();
+        add_glyph(&mut f, "a", 1150.0);
+        InferFixedPitch::new().apply(&mut f).unwrap();
+        let glyphs = crate::convertors::glyphs3::as_glyphs3(&f).unwrap();
+        let cp = glyphs
+            .custom_parameters
+            .iter()
+            .find(|cp| cp.name == "isFixedPitch")
+            .expect("an isFixedPitch custom parameter");
+        assert_eq!(cp.value, glyphslib::Plist::Integer(1));
+    }
+}
