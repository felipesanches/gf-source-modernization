+//! Detecting a monospaced font: one whose glyphs all share a single advance.
+
+use crate::{Font, Glyph, LayerType};
+
+/// Whether a glyph's advance says nothing about the spacing of text, so that it
+/// is left out when deciding whether a font is monospaced: `.notdef`, and the
+/// control-character glyphs `.null` and `nonmarkingreturn` or any glyph mapped
+/// to U+0000 or U+000D.
+fn spacing_irrelevant(glyph: &Glyph) -> bool {
+    matches!(
+        glyph.name.as_str(),
+        ".notdef" | ".null" | "nonmarkingreturn"
+    ) || glyph.codepoints.iter().any(|&c| c == 0x0000 || c == 0x000D)
+}
+
+/// The advance every glyph of the font has in every master, or `None` when two
+/// advances differ or there is no glyph to measure.
+///
+/// Advances are rounded to whole font units. Left out: glyphs with a zero advance
+/// (such as combining marks), glyphs that are not exported, `.notdef`, and the
+/// control-character glyphs `.null` and `nonmarkingreturn` (or any glyph mapped to
+/// U+0000 or U+000D).
+pub(crate) fn monospaced_advance(font: &Font) -> Option<i32> {
+    let mut shared = None;
+    for glyph in font.glyphs.iter() {
+        if !glyph.exported || spacing_irrelevant(glyph) {
+            continue;
+        }
+        for layer in glyph.layers.iter() {
+            if !matches!(layer.master, LayerType::DefaultForMaster(_)) {
+                continue;
+            }
+            let advance = layer.width.round() as i32;
+            if advance == 0 {
+                continue;
+            }
+            match shared {
+                None => shared = Some(advance),
+                Some(previous) if previous != advance => return None,
+                Some(_) => {}
+            }
+        }
+    }
+    shared
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Layer, Master};
+
+    fn font() -> Font {
+        let mut f = Font::new();
+        f.masters.push(Master::default());
+        f
+    }
+
+    fn add_glyph<'a>(f: &'a mut Font, name: &str, advance: f32) -> &'a mut Glyph {
+        let mut layer = Layer::new(advance);
+        layer.master = LayerType::DefaultForMaster(f.masters[0].id.clone());
+        let mut glyph = Glyph::new(name);
+        glyph.exported = true;
+        glyph.layers.push(layer);
+        f.glyphs.push(glyph);
+        let last = f.glyphs.len() - 1;
+        &mut f.glyphs[last]
+    }
+
+    #[test]
+    fn test_one_advance_is_shared() {
+        let mut f = font();
+        add_glyph(&mut f, "a", 600.0);
+        add_glyph(&mut f, "b", 600.4);
+        assert_eq!(monospaced_advance(&f), Some(600));
+        add_glyph(&mut f, "c", 500.0);
+        assert_eq!(monospaced_advance(&f), None);
+    }
+
+    #[test]
+    fn test_glyphs_that_say_nothing_about_spacing_are_left_out() {
+        let mut f = font();
+        add_glyph(&mut f, "a", 600.0);
+        add_glyph(&mut f, "acutecomb", 0.0);
+        add_glyph(&mut f, ".notdef", 500.0);
+        add_glyph(&mut f, ".null", 0.0);
+        add_glyph(&mut f, "nonmarkingreturn", 300.0);
+        add_glyph(&mut f, "CR", 300.0).codepoints.push(0x000D);
+        add_glyph(&mut f, "unused", 300.0).exported = false;
+        assert_eq!(monospaced_advance(&f), Some(600));
+    }
+
+    #[test]
+    fn test_every_master_counts() {
+        let mut f = font();
+        f.masters.push(Master {
+            id: "bold".to_string(),
+            ..Default::default()
+        });
+        add_glyph(&mut f, "a", 600.0);
+        let mut layer = Layer::new(600.0);
+        layer.master = LayerType::DefaultForMaster("bold".to_string());
+        f.glyphs[0].layers.push(layer.clone());
+        assert_eq!(monospaced_advance(&f), Some(600));
+        layer.width = 650.0;
+        f.glyphs[0].layers[1] = layer;
+        assert_eq!(monospaced_advance(&f), None);
+    }
+
+    #[test]
+    fn test_no_glyph_to_measure() {
+        let mut f = font();
+        add_glyph(&mut f, ".notdef", 500.0);
+        add_glyph(&mut f, "space", 0.0);
+        assert_eq!(monospaced_advance(&f), None);
+    }
+}
