@@ -1232,6 +1223,38 @@ pub fn uncompile_bytes(
 /// This partially decompiles the font, giving you the component parts so that you can
 /// put them where you want them. Useful for font editors and other tools that want the
 /// data but don't want to go all the way to a fea file.
+/// The glyph names a font states, made unique as fontTools makes them: a post
+/// table may give two glyphs the same name, and a name already taken gets the
+/// first free suffix of .1, .2, ...
+pub fn unique_glyph_names(font: &skrifa::FontRef) -> Vec<SmolStr> {
+    let glyph_names = GlyphNames::new(font);
+    let stated: Vec<SmolStr> = (0..glyph_names.num_glyphs())
+        .map(GlyphId::new)
+        .map(|gid| {
+            SmolStr::new(
+                glyph_names
+                    .get(gid)
+                    .map(|s| s.to_string())
+                    .unwrap_or_else(|| format!("gid{:04}", gid)),
+            )
+        })
+        .collect();
+    let all: HashSet<SmolStr> = stated.iter().cloned().collect();
+    let mut taken: HashSet<SmolStr> = HashSet::new();
+    stated
+        .into_iter()
+        .map(|name| {
+            if taken.insert(name.clone()) {
+                return name;
+            }
+            (1..)
+                .map(|n| SmolStr::new(format!("{name}.{n}")))
+                .find(|candidate| !all.contains(candidate) && taken.insert(candidate.clone()))
+                .unwrap_or(name)
+        })
+        .collect()
+}
