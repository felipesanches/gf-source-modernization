From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Correa da Silva Sanches <juca@members.fsf.org>
Date: Fri, 9 Oct 2026 04:23:41 +0100
Subject: [PATCH 4/5] sr-aef: name a made-up mark class anchor so it is not a
 component anchor

A mark class with no guessable position got the anchor name mark_class_<class>_<n>.
Font editors and fontc read an anchor name ending in _<digits> as one of a ligature's
components, which a mark anchor cannot be ("mark anchors cannot be numbered"), so a
converted Almarai or Zen Antique did not build. The name is now
mark_class_<class>x<n>.

Assisted by an AI agent (Claude Opus 5.5)
---
 sr-aef/src/gpos.rs |  4 ++--
 sr-aef/src/lib.rs  | 27 +++++++++++++++++++--------
 2 files changed, 21 insertions(+), 10 deletions(-)

diff --git a/sr-aef/src/gpos.rs b/sr-aef/src/gpos.rs
index ebbd1a75..532157cc 100644
--- a/sr-aef/src/gpos.rs
+++ b/sr-aef/src/gpos.rs
@@ -496,7 +496,7 @@ impl<'a> UncompileContext<'a> {
             let anchor_name = guessed_name_by_class
                 .get(&class_number)
                 .cloned()
-                .unwrap_or_else(|| self.gensym(&format!("mark_class_{}", class_number)));
+                .unwrap_or_else(|| self.mark_class_symbol(class_number));
             self.register_mark_class(mark_class, &anchor_name);
             class_to_anchor_name.insert(class_number, anchor_name);
         }
@@ -736,7 +736,7 @@ impl<'a> UncompileContext<'a> {
                 continue;
             }
             // Create one with a symbol
-            let name = self.gensym(&format!("mark_class_{}", class_number));
+            let name = self.mark_class_symbol(*class_number);
             self.anchors
                 .insert(name.clone(), base_glyphs_anchors.clone());
             new_names.push(name);
diff --git a/sr-aef/src/lib.rs b/sr-aef/src/lib.rs
index 12587613..91258169 100644
--- a/sr-aef/src/lib.rs
+++ b/sr-aef/src/lib.rs
@@ -350,6 +350,17 @@ impl<'a> UncompileContext<'a> {
         name
     }
 
+    /// A made-up name for the anchor of a mark class, `mark_class_<class>x<n>`.
+    /// A font editor reads an anchor name ending in `_<digits>` as one of a
+    /// ligature's components, which a mark anchor cannot be.
+    pub(crate) fn mark_class_symbol(&mut self, class_number: u16) -> SmolStr {
+        let prefix = SmolStr::new(format!("mark_class_{}x", class_number));
+        let symbol_index = self.symbols.entry(prefix.clone()).or_insert(1);
+        let name = SmolStr::new(format!("{}{}", prefix, symbol_index));
+        *symbol_index += 1;
+        name
+    }
+
     fn assign_lookup_name<T: SubOrPos>(&mut self, prefix: &str, index: u16, phase: T) {
         let name = self.gensym(prefix);
         self.lookup_map.insert((phase.to_string(), index), name);
@@ -1279,7 +1290,7 @@ GlyphClassDef [A], [], [grave acute dotbelowcomb], [];
 
 markClass grave <anchor 200 150> @bottomleft;
 markClass acute <anchor 350 0> @bottomleft;
-markClass dotbelowcomb <anchor 200 -200> @mark_class_1_1;
+markClass dotbelowcomb <anchor 200 -200> @mark_class_1x1;
 lookup gsub_single_1 {
     sub a by b;
 } gsub_single_1;
@@ -1334,7 +1345,7 @@ lookup gsub_single_6 {
 lookup gpos_mark_to_base_1 {
     pos base A
         <anchor 150 100> mark @bottomleft
-        <anchor -200 -200> mark @mark_class_1_1;
+        <anchor -200 -200> mark @mark_class_1x1;
 } gpos_mark_to_base_1;
 lookup gpos_single_1 {
     pos A 10;
@@ -1898,8 +1909,8 @@ GlyphClassDef [b], [a], [c d], [];
 } GDEF;
 
 markClass c <anchor 0 500> @left;
-markClass c <anchor 0 500> @mark_class_0_1;
-markClass d <anchor 0 0> @mark_class_1_1;
+markClass c <anchor 0 500> @mark_class_0x1;
+markClass d <anchor 0 0> @mark_class_1x1;
 markClass c <anchor 0 500> @topleft;
 lookup gpos_mark_to_base_1 {
     pos base a
@@ -1909,11 +1920,11 @@ lookup gpos_mark_to_base_1 {
 } gpos_mark_to_base_1;
 lookup gpos_mark_to_ligature_1 {
     pos ligature a
-        <anchor 100 500> mark @mark_class_0_1
-        <anchor NULL> mark @mark_class_1_1
+        <anchor 100 500> mark @mark_class_0x1
+        <anchor NULL> mark @mark_class_1x1
         ligComponent
-        <anchor 400 500> mark @mark_class_0_1
-        <anchor NULL> mark @mark_class_1_1;
+        <anchor 400 500> mark @mark_class_0x1
+        <anchor NULL> mark @mark_class_1x1;
 } gpos_mark_to_ligature_1;
 lookup gpos_mark_to_mark_1 {
     pos mark c
