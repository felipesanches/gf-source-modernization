+
+/// A glyph name a feature file can hold: a character outside `A-Z a-z 0-9 . _ -`
+/// becomes `_`, and a name starting with a digit or a hyphen gets a leading `_`.
+fn fea_glyph_name(name: &str) -> SmolStr {
+    let mut out: String = name
+        .chars()
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '-') {
+                c
+            } else {
+                '_'
+            }
+        })
+        .collect();
+    if out.is_empty() || out.starts_with(|c: char| c.is_ascii_digit() || c == '-') {
+        out.insert(0, '_');
+    }
+    SmolStr::new(out)
+}
+
+/// Each name kept, unless an earlier glyph has it: then the first free `.1`, `.2`,
+/// ... suffix, as fontTools does. A feature file takes a name starting with a period
+/// only as `.notdef`, so a repeated `.notdef` (or any name starting with a period)
+/// becomes `_notdef.1` and so on.
+fn unique_names(stated: Vec<SmolStr>) -> Vec<SmolStr> {
     let all: HashSet<SmolStr> = stated.iter().cloned().collect();
     let mut taken: HashSet<SmolStr> = HashSet::new();
     stated
@@ -1258,8 +1285,12 @@ pub fn unique_glyph_names(font: &skrifa::FontRef) -> Vec<SmolStr> {
             if taken.insert(name.clone()) {
