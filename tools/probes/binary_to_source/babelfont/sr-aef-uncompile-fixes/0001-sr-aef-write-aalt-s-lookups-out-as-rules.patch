diff --git a/sr-aef/resources/make_aalt.py b/sr-aef/resources/make_aalt.py
new file mode 100644
index 00000000..451e7eb7
--- /dev/null
+++ b/sr-aef/resources/make_aalt.py
@@ -0,0 +1,18 @@
+"""Compiles aalt.fea into aalt.ttf (fontTools feaLib, which accepts lookup
+references in aalt as a font in the wild has them): python3 make_aalt.py"""
+from fontTools.feaLib.builder import addOpenTypeFeatures
+from fontTools.fontBuilder import FontBuilder
+from fontTools.ttLib.tables._g_l_y_f import Glyph
+
+order = [".notdef", "a", "a.alt1", "b", "b.alt1", "b.alt2"]
+fb = FontBuilder(1000, isTTF=True)
+fb.setupGlyphOrder(order)
+fb.setupCharacterMap({ord("a"): "a", ord("b"): "b"})
+fb.setupGlyf({name: Glyph() for name in order})
+fb.setupHorizontalMetrics({name: (500, 0) for name in order})
+fb.setupHorizontalHeader()
+fb.setupPost()
+addOpenTypeFeatures(fb.font, "aalt.fea")
+fb.font["head"].created = fb.font["head"].modified = 0
+fb.font.recalcTimestamp = False
+fb.save("aalt.ttf")
diff --git a/sr-aef/src/lib.rs b/sr-aef/src/lib.rs
index 1b9eb7c6..c0a8f267 100644
--- a/sr-aef/src/lib.rs
+++ b/sr-aef/src/lib.rs
@@ -954,6 +954,35 @@ impl<'a> UncompileContext<'a> {
     }
 
     fn add_feature_lookups(&mut self, feature_tag: Tag, lookups: Vec<Statement>) {
+        // aalt may hold only rules and feature references, so its lookups are
+        // written out as their single and alternate substitution rules
+        let lookups = if feature_tag == Tag::new(b"aalt") {
+            lookups
+                .into_iter()
+                .flat_map(|statement| match &statement {
+                    Statement::LookupReference(reference) => self
+                        .lookups
+                        .get(reference.lookup_name.as_str())
+                        .map(|block| {
+                            block
+                                .statements
+                                .iter()
+                                .filter(|s| {
+                                    matches!(
+                                        s,
+                                        Statement::SingleSubst(_) | Statement::AlternateSubst(_)
+                                    )
+                                })
+                                .cloned()
+                                .collect()
+                        })
+                        .unwrap_or_else(|| vec![statement]),
+                    _ => vec![statement],
+                })
+                .collect()
+        } else {
+            lookups
+        };
         let statements = self
             .features
             .entry(feature_tag.to_string().into())
@@ -1658,6 +1687,19 @@ lookup gpos_pair_1;
         );
     }
 
+    #[test]
+    fn test_uncompile_aalt_rules() {
+        // aalt may hold only rules and feature references
+        let data = std::fs::read("resources/aalt.ttf").unwrap();
+        let fontref = skrifa::FontRef::new(&data).unwrap();
+        let ff = uncompile(&fontref, true).unwrap();
+        let fea = ff.as_fea("");
+        let aalt = &fea[fea.find("feature aalt").unwrap()..];
+        assert!(!aalt.contains("lookup "), "{fea}");
+        assert!(aalt.contains("sub a by a.alt1;"), "{fea}");
+        assert!(aalt.contains("sub b from [b.alt1 b.alt2];"), "{fea}");
+    }
