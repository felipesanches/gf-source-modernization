diff --git a/sr-aef/resources/aalt.fea b/sr-aef/resources/aalt.fea
new file mode 100644
index 00000000..5cd1a10f
--- /dev/null
+++ b/sr-aef/resources/aalt.fea
@@ -0,0 +1,14 @@
+languagesystem DFLT dflt;
+
+lookup single {
+    sub a by a.alt1;
+} single;
+
+lookup alternate {
+    sub b from [b.alt1 b.alt2];
+} alternate;
+
+feature aalt {
+    lookup single;
+    lookup alternate;
+} aalt;
