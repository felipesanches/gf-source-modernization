Subject: [PATCH 05/17] ttf: read the font revision from head

The reader left the version at its default 1.0, so a converted font compiled
to head.fontRevision 1.0 whatever the binary stated. It is now read from
head.fontRevision, the minor in thousandths as Glyphs and UFO state it
(0x00003333, 0.19999, is 0.200 and compiles back to 0x00003333).

Assisted by an AI agent (Claude Opus 5.5)
---
 babelfont/src/convertors/ttf.rs | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/babelfont/src/convertors/ttf.rs b/babelfont/src/convertors/ttf.rs
index f120c881..b00e8239 100644
--- a/babelfont/src/convertors/ttf.rs
+++ b/babelfont/src/convertors/ttf.rs
@@ -32,6 +32,7 @@ pub fn load<T: AsRef<std::path::Path>>(path: T) -> Result<Font, BabelfontError>
     let fontref =
         skrifa::FontRef::new(&binary).map_err(|e| BabelfontError::BinaryFontRead(e.to_string()))?;
     font.upm = fontref.head()?.units_per_em();
+    font.version = font_version(&fontref)?;
 
     load_axes(&fontref, &mut font)?;
     load_axis_mappings(&fontref, &mut font)?;
@@ -44,6 +45,17 @@ pub fn load<T: AsRef<std::path::Path>>(path: T) -> Result<Font, BabelfontError>
     Ok(font)
 }
 
+/// head.fontRevision as (major, minor), the minor in thousandths as Glyphs
+/// and UFO state it: 0x00003333 (0.19999) is 0.200
+fn font_version(fontref: &skrifa::FontRef) -> Result<(u16, u16), BabelfontError> {
+    let revision = fontref.head()?.font_revision().to_f64();
+    let thousandths = (revision * 1000.0).round();
+    Ok((
+        (thousandths / 1000.0).floor() as u16,
+        (thousandths % 1000.0) as u16,
+    ))
+}
