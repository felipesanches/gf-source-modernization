diff --git a/babelfont/resources/ttf/make_fixtures.py b/babelfont/resources/ttf/make_fixtures.py
index 2bdcca66..c0548bd6 100644
--- a/babelfont/resources/ttf/make_fixtures.py
+++ b/babelfont/resources/ttf/make_fixtures.py
@@ -29,6 +29,9 @@ GPOS kern feature and a legacy kern table (a f_f -40), which a shaper ignores.
 Unnamed.ttf has no glyph names (post format 3): A (U+0041), Aring (U+00C5, a
 component of A), an unencoded alternate of A reached by salt, and A Aring kerned
 -50 in a legacy kern table.
+
+DuplicateNames.ttf's post table names glyphs 2 and 3 both "dupe" (a post table
+may); Acomp is a component of glyph 3.
 """
 from fontTools.feaLib.builder import addOpenTypeFeaturesFromString
 from fontTools.fontBuilder import FontBuilder
@@ -168,3 +171,22 @@ addOpenTypeFeaturesFromString(fb.font, "feature salt { sub A by A.alt; } salt;")
 legacy_kern(fb.font, {("A", "Aring"): -50})
 fb.setupPost(keepGlyphNames=False)
 save(fb, "Unnamed.ttf")
+
+
+order = [".notdef", "A", "dupa", "dupb", "Acomp"]
+fb = FontBuilder(1000, isTTF=True)
+fb.setupGlyphOrder(order)
+fb.setupCharacterMap({0x41: "A", 0xC0: "Acomp"})
+fb.setupGlyf({".notdef": Glyph(), "A": rect(50, 0, 550, 700), "dupa": rect(60, 0, 160, 100),
+              "dupb": rect(70, 0, 170, 100), "Acomp": composite(("dupb", 0, 0, None))})
+fb.setupHorizontalMetrics({".notdef": (500, 0), "A": (600, 50), "dupa": (600, 60), "dupb": (600, 70),
+                           "Acomp": (600, 70)})
+fb.setupHorizontalHeader(ascent=800, descent=-200)
+fb.setupNameTable({"familyName": "Fixture Duplicate Names", "styleName": "Regular"})
+fb.setupOS2(sTypoAscender=800, sTypoDescender=-200, usWinAscent=800, usWinDescent=200)
+fb.setupPost()
+save(fb, "DuplicateNames.ttf")
+data = open("DuplicateNames.ttf", "rb").read()
+# both names become "dupe": the same length, so nothing in the post table moves
+assert data.count(b"\x04dupa") == 1 and data.count(b"\x04dupb") == 1
+open("DuplicateNames.ttf", "wb").write(data.replace(b"\x04dupa", b"\x04dupe").replace(b"\x04dupb", b"\x04dupe"))
