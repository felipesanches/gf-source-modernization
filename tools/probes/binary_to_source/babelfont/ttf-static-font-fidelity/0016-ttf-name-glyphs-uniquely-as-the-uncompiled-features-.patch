+    fn test_duplicate_glyph_names() {
+        // the post table names glyphs 2 and 3 both "dupe"; Acomp uses glyph 3
+        let font = load(DUPLICATE_NAMES).unwrap();
+        let names: Vec<&str> = font.glyphs.iter().map(|g| g.name.as_str()).collect();
