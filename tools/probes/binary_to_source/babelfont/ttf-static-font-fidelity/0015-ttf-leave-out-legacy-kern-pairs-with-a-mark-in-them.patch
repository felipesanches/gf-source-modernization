index d6ca6807..2bdcca66 100644
--- a/babelfont/resources/ttf/make_fixtures.py
+++ b/babelfont/resources/ttf/make_fixtures.py
@@ -17,7 +17,8 @@ StaticLegacy.ttf is a static font as an old FontForge build leaves it:
   right), not by the composite's own (40).
 * gravecomb (U+0300, advance 0) and commaaccent (unencoded, advance 120): with no
   GDEF, a shaper takes the first for a mark and the second for a base.
-* a legacy kern table of two subtables: x H -30, H x -20, and x x 5 in both.
+* a legacy kern table of two subtables: x H -30, H x -20, and x x 5 in both;
+  x gravecomb -15, which a shaper never applies (it skips marks).
 
 GdefClasses.ttf carries GDEF glyph classes: gravecomb a base (class 1, advance
 190), acutecomb a mark with no advance, tildecomb a mark with one (300), f_f a
@@ -117,7 +118,8 @@ fb.setupOS2(
 fb.setupPost()
 fb.font["head"].fontRevision = 2.005
 fb.font["head"].lowestRecPPEM = 9
-legacy_kern(fb.font, {("x", "H"): -30, ("x", "x"): 5}, {("H", "x"): -20, ("x", "x"): 5})
+legacy_kern(fb.font, {("x", "H"): -30, ("x", "x"): 5, ("x", "gravecomb"): -15},
+            {("H", "x"): -20, ("x", "x"): 5})
 save(fb, "StaticLegacy.ttf")
 
 
diff --git a/babelfont/src/convertors/ttf.rs b/babelfont/src/convertors/ttf.rs
