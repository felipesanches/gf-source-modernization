 /// A legacy kern table's horizontal pairs, as the default master's kerning,
-/// read where a shaper reads them: only when GPOS has no kern feature. The
-/// pairs of several subtables add up.
+/// read where a shaper reads them: only when GPOS has no kern feature, and
+/// never across a mark (a shaper applies the table ignoring marks, so a pair
+/// with a mark in it never applies). The pairs of several subtables add up.
 fn load_legacy_kerning(fontref: &skrifa::FontRef, font: &mut Font) -> Result<(), BabelfontError> {
     let Ok(kern) = fontref.kern() else {
         return Ok(());
@@ -643,6 +644,9 @@ fn load_legacy_kerning(fontref: &skrifa::FontRef, font: &mut Font) -> Result<(),
             let left = font.glyphs.get_by_index(pair.left().to_u32() as usize);
             let right = font.glyphs.get_by_index(pair.right().to_u32() as usize);
             if let (Some(left), Some(right)) = (left, right) {
+                if left.category == GlyphCategory::Mark || right.category == GlyphCategory::Mark {
+                    continue;
+                }
                 *pairs
                     .entry((left.name.clone(), right.name.clone()))
                     .or_default() += pair.value() as i32;
@@ -1099,6 +1103,8 @@ mod tests {
         assert_eq!(kerning.get(&("x".into(), "H".into())), Some(&-30));
         assert_eq!(kerning.get(&("H".into(), "x".into())), Some(&-20));
         assert_eq!(kerning.get(&("x".into(), "x".into())), Some(&10));
+        // a shaper skips marks applying the table: gravecomb's pair never applies
+        assert_eq!(kerning.get(&("x".into(), "gravecomb".into())), None);
         // a shaper ignores kern when GPOS has a kern feature, and so does this
         let font = load(GDEF_CLASSES).unwrap();
         assert!(font.masters[0].kerning.is_empty());
