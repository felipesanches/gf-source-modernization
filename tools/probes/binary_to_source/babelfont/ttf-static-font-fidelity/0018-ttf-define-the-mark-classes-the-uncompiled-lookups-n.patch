+    #[test]
+    fn test_mark_classes_defined() {
+        // every mark class a lookup names is defined in the features
+        let fea = load(GDEF_CLASSES).unwrap().features.to_fea();
+        let used: Vec<&str> = fea
+            .split("mark @")
+            .skip(1)
+            .map(|rest| {
+                rest.split(|c: char| c == ';' || c.is_whitespace())
+                    .next()
+                    .unwrap()
+            })
+            .collect();
+        assert!(!used.is_empty(), "{fea}");
+        for class in used {
+            assert!(
+                fea.contains(&format!("@{class};")),
+                "@{class} undefined: {fea}"
+            );
+            assert!(fea.contains("markClass "), "{fea}");
+        }
+    }
