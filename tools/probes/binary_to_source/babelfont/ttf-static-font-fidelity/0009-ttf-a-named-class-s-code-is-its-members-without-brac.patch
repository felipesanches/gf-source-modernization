diff --git a/babelfont/resources/ttf/make_fixtures.py b/babelfont/resources/ttf/make_fixtures.py
index 551c7d99..88c64317 100644
--- a/babelfont/resources/ttf/make_fixtures.py
+++ b/babelfont/resources/ttf/make_fixtures.py
@@ -20,7 +20,8 @@ StaticLegacy.ttf is a static font as an old FontForge build leaves it:
 
 GdefClasses.ttf carries GDEF glyph classes: gravecomb a base (class 1, advance
 190), acutecomb a mark with no advance, tildecomb a mark with one (300), f_f a
-ligature.
+ligature. Its calt's backtrack covers five glyphs, which reads back as a named
+glyph class.
 """
 from fontTools.feaLib.builder import addOpenTypeFeaturesFromString
 from fontTools.fontBuilder import FontBuilder
@@ -110,6 +111,10 @@ fb.setupNameTable({"familyName": "Fixture Gdef", "styleName": "Regular"})
 fb.setupOS2(sTypoAscender=800, sTypoDescender=-200, usWinAscent=800, usWinDescent=200)
 fb.setupPost()
 addOpenTypeFeaturesFromString(fb.font, """
+lookup up { sub gravecomb by acutecomb; } up;
+feature calt {
+    sub [a gravecomb acutecomb tildecomb f_f] gravecomb' lookup up;
+} calt;
 table GDEF {
     GlyphClassDef [a gravecomb], [f_f], [acutecomb tildecomb], ;
 } GDEF;
diff --git a/babelfont/src/convertors/ttf.rs b/babelfont/src/convertors/ttf.rs
