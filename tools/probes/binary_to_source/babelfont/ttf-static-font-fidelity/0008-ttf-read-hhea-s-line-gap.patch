diff --git a/babelfont/resources/ttf/make_fixtures.py b/babelfont/resources/ttf/make_fixtures.py
index 8d454b49..551c7d99 100644
--- a/babelfont/resources/ttf/make_fixtures.py
+++ b/babelfont/resources/ttf/make_fixtures.py
@@ -6,7 +6,8 @@ StaticLegacy.ttf is a static font as an old FontForge build leaves it:
 
 * OS/2 version 1 (no sxHeight / sCapHeight), usWeightClass 500, usWidthClass 6,
   fsType 0, a PANOSE, fsSelection REGULAR | USE_TYPO_METRICS; head.fontRevision
-  2.005, lowestRecPPEM 9; style "Medium" (name ID 17; ID 2 is "Regular").
+  2.005, lowestRecPPEM 9; hhea lineGap 25; style "Medium" (name ID 17; ID 2 is
+  "Regular").
 * bar: a simple glyph whose hmtx lsb (110) is not its glyf xMin (100), so a
   TrueType rasterizer draws it 10 units right of its stored outline.
 * barflip: bar turned 180 degrees (scale -1, -1).
@@ -76,7 +77,7 @@ lsb = {".notdef": 0, "x": 50, "H": 60, "bar": 110, "barflip": 100, "bars": 105,
        "gravecomb": -200, "commaaccent": 20}
 advance = {"gravecomb": 0, "commaaccent": 120}
 fb.setupHorizontalMetrics({g: (advance.get(g, 800), lsb[g]) for g in order})
-fb.setupHorizontalHeader(ascent=800, descent=-200)
+fb.setupHorizontalHeader(ascent=800, descent=-200, lineGap=25)
 fb.setupNameTable({
     "familyName": "Fixture Medium",
     "styleName": "Regular",
diff --git a/babelfont/src/convertors/ttf.rs b/babelfont/src/convertors/ttf.rs
index 6778f0e1..3fd6487b 100644
--- a/babelfont/src/convertors/ttf.rs
+++ b/babelfont/src/convertors/ttf.rs
@@ -325,6 +325,10 @@ fn load_metrics(
         MetricType::HheaDescender,
         fontref.hhea()?.descender().to_i16() as i32,
     );
+    metrics.insert(
+        MetricType::HheaLineGap,
+        fontref.hhea()?.line_gap().to_i16() as i32,
+    );
 
     // post stores the angle negative for a right lean; babelfont stores the
     // Glyphs convention, the opposite sign.
@@ -933,4 +937,11 @@ mod tests {
         assert_eq!(metrics.get(&MetricType::XHeight), Some(&480));
         assert_eq!(metrics.get(&MetricType::CapHeight), Some(&700));
     }
+
+    #[test]
+    fn test_hhea_line_gap() {
+        let font = load(STATIC_LEGACY).unwrap();
+        let metrics = &font.masters[0].metrics;
+        assert_eq!(metrics.get(&MetricType::HheaLineGap), Some(&25));
+    }
 }
