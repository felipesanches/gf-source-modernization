+/// A quadratic whose off-curve point sits on one of its on-curve ends is the straight
+/// line between them: such an off-curve point is dropped, and a quadratic left without
+/// one is a line. A glyf contour may record off, on and off-curve points at one place,
+/// a corner; kept as they are, a later step that merges coincident points can keep an
+/// off-curve one and round the corner.
+fn drop_degenerate_offcurves(path: &mut crate::Path) {
+    let n = path.nodes.len();
+    if !path.closed || n < 3 {
+        return;
+    }
+    let on_curve = |node: &Node| node.nodetype != NodeType::OffCurve;
+    let same_place = |a: &Node, b: &Node| a.x == b.x && a.y == b.y;
+    let keep: Vec<bool> = (0..n)
+        .map(|i| {
+            let node = &path.nodes[i];
+            if on_curve(node) {
+                return true;
+            }
+            let prev = &path.nodes[(i + n - 1) % n];
+            let next = &path.nodes[(i + 1) % n];
+            !(on_curve(prev) && same_place(prev, node) || on_curve(next) && same_place(next, node))
+        })
+        .collect();
+    if keep.iter().all(|&k| k) {
+        return;
+    }
+    let mut nodes: Vec<Node> = path
+        .nodes
+        .iter()
+        .zip(keep)
+        .filter(|(_, k)| *k)
+        .map(|(node, _)| node.clone())
+        .collect();
+    let m = nodes.len();
+    for i in 0..m {
+        if nodes[i].nodetype == NodeType::QCurve
+            && nodes[(i + m - 1) % m].nodetype != NodeType::OffCurve
+        {
+            nodes[i].nodetype = NodeType::Line;
+        }
+    }
+    path.nodes = nodes;
+}
