@@ -109,7 +109,12 @@ fn name_id_to_i18n(fontref: &skrifa::FontRef, name_id: StringId) -> crate::I18ND
             } else {
                 lang
             };
-            dict.insert(lang.to_string(), name.to_string());
+            // a record skrifa cannot decode (a MacJapanese one, say) reads as
+            // empty, and is left out rather than stated as an empty name
+            let value = name.to_string();
+            if !value.is_empty() {
+                dict.insert(lang.to_string(), value);
+            }
         }
     }
     dict
@@ -1234,6 +1239,22 @@ mod tests {
         assert_eq!(component.reference, "dupe.1");
     }
 
+    #[test]
+    fn test_name_read_from_any_record() {
+        // the MacJapanese record cannot be decoded; the Windows one can
+        let font = load(STATIC_LEGACY).unwrap();
+        let ja = font
+            .names
+            .family_name
+            .0
+            .iter()
+            .find(|(lang, _)| lang.starts_with("ja"));
+        assert_eq!(
+            ja.map(|(_, v)| v.as_str()),
+            Some("\u{3057}\u{3063}\u{307d}\u{308a}")
+        );
+    }
