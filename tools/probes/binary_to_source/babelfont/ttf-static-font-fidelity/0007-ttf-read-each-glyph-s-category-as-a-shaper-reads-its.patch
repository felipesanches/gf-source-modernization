+
+/// Each glyph's GDEF class as a shaper reads it: from GDEF's glyph classes, or
+/// without them, a mark for a nonspacing-mark codepoint and a base for anything
+/// else. Every glyph is given a category, so that a compiler does not guess one
+/// from its name; a mark is Nonspacing if it has no advance, else Spacing
+/// Combining, which keeps its advance.
+fn load_categories(fontref: &skrifa::FontRef, font: &mut Font) -> Result<(), BabelfontError> {
+    let class_def = match fontref.gdef() {
+        Ok(gdef) => gdef.glyph_class_def().transpose()?,
+        Err(_) => None,
+    };
+    let general_category = CodePointMapData::<GeneralCategory>::new();
+    let metrics = fontref.glyph_metrics(Size::unscaled(), LocationRef::default());
+    for (gid, glyph) in font.glyphs.iter_mut().enumerate() {
+        let gid = GlyphId::new(gid as u32);
+        let class = match &class_def {
+            Some(class_def) => class_def.get(gid),
+            None if glyph.codepoints.iter().any(|&cp| {
+                char::from_u32(cp)
+                    .is_some_and(|c| general_category.get(c) == GeneralCategory::NonspacingMark)
+            }) =>
+            {
+                3
+            }
+            None => 1,
+        };
+        let (category, subcategory) = match class {
+            2 => (GlyphCategory::Ligature, Some("Ligature")),
+            3 if metrics.advance_width(gid).unwrap_or_default() == 0.0 => {
+                (GlyphCategory::Mark, Some("Nonspacing"))
+            }
+            3 => (GlyphCategory::Mark, Some("Spacing Combining")),
+            _ => (GlyphCategory::Base, None),
+        };
+        glyph.category = category;
+        if let Some(subcategory) = subcategory {
+            glyph.format_specific.insert(
+                "subcategory".to_string(),
+                serde_json::Value::String(subcategory.to_string()),
+            );
+        }
+    }
     Ok(())
 }
 
