+    #[test]
+    fn test_categories_from_gdef() {
+        let font = load(GDEF_CLASSES).unwrap();
+        // a base in GDEF, though U+0300 is a nonspacing mark
+        assert_eq!(category(&font, "gravecomb"), (GlyphCategory::Base, None));
+        assert_eq!(
+            category(&font, "acutecomb"),
+            (GlyphCategory::Mark, Some("Nonspacing".to_string()))
+        );
+        // a mark with an advance keeps it
+        assert_eq!(
+            category(&font, "tildecomb"),
