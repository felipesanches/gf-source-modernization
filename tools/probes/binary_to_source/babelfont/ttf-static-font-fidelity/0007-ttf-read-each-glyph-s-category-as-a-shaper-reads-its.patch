+    #[test]
+    fn test_categories_without_gdef() {
+        // as a shaper infers them: U+0300 is a nonspacing mark; an unencoded
+        // glyph is a base, whatever its name suggests
+        let font = load(STATIC_LEGACY).unwrap();
+        assert_eq!(
+            category(&font, "gravecomb"),
+            (GlyphCategory::Mark, Some("Nonspacing".to_string()))
+        );
+        assert_eq!(category(&font, "commaaccent"), (GlyphCategory::Base, None));
+        assert_eq!(category(&font, "x"), (GlyphCategory::Base, None));
+    }
