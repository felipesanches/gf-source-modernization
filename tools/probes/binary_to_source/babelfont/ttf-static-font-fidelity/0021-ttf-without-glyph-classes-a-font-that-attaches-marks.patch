--- a/babelfont/resources/ttf/make_fixtures.py
+++ b/babelfont/resources/ttf/make_fixtures.py
@@ -35,6 +35,10 @@ component of A), an unencoded alternate of A reached by salt, and A Aring kerned
 
 DuplicateNames.ttf's post table names glyphs 2 and 3 both "dupe" (a post table
 may); Acomp is a component of glyph 3.
+
+MarkNoGdef.ttf has no GDEF but a mark feature attaching gravecomb (U+0300,
+advance 0) to a; commaaccent is unencoded. A shaper takes gravecomb for a mark
+from its codepoint, and a and commaaccent for bases.
 """
 from fontTools.feaLib.builder import addOpenTypeFeaturesFromString
 from fontTools.fontBuilder import FontBuilder
@@ -203,3 +207,25 @@ data = open("DuplicateNames.ttf", "rb").read()
 # both names become "dupe": the same length, so nothing in the post table moves
 assert data.count(b"\x04dupa") == 1 and data.count(b"\x04dupb") == 1
 open("DuplicateNames.ttf", "wb").write(data.replace(b"\x04dupa", b"\x04dupe").replace(b"\x04dupb", b"\x04dupe"))
+
+
+order = [".notdef", "a", "gravecomb", "commaaccent"]
+fb = FontBuilder(1000, isTTF=True)
+fb.setupGlyphOrder(order)
+fb.setupCharacterMap({ord("a"): "a", 0x0300: "gravecomb"})
+fb.setupGlyf({".notdef": Glyph(), "a": rect(50, 0, 450, 500), "gravecomb": rect(-150, 550, -40, 700),
+              "commaaccent": rect(20, -200, 100, -50)})
+fb.setupHorizontalMetrics({".notdef": (500, 0), "a": (500, 50), "gravecomb": (0, -150),
+                           "commaaccent": (120, 20)})
+fb.setupHorizontalHeader(ascent=800, descent=-200)
+fb.setupNameTable({"familyName": "Fixture Mark No Gdef", "styleName": "Regular"})
+fb.setupOS2(sTypoAscender=800, sTypoDescender=-200, usWinAscent=800, usWinDescent=200)
+fb.setupPost()
+addOpenTypeFeaturesFromString(fb.font, """
+markClass gravecomb <anchor -100 600> @TOP;
+feature mark {
+    pos base a <anchor 250 500> mark @TOP;
+} mark;
+""")
+del fb.font["GDEF"]
+save(fb, "MarkNoGdef.ttf")
