+    #[test]
+    fn test_vertical_metrics() {
+        // vhea 900/-100/0; a: advance height 1000, tsb 100, yMax 500 (origin 600);
+        // the typographic ascender is 800
+        let font = load(GDEF_CLASSES).unwrap();
+        let master = &font.masters[0];
+        let cp = |name: &str| {
+            master
+                .format_specific
+                .get(&format!(
+                    "com.schriftgestalt.Glyphs.customParameters.{name}"
+                ))
+                .and_then(|v| v.get("value"))
+                .and_then(|v| v.as_f64())
+        };
+        assert_eq!(cp("vheaVertAscender"), Some(900.0));
+        assert_eq!(cp("vheaVertDescender"), Some(-100.0));
+        assert_eq!(cp("vheaVertLineGap"), Some(0.0));
+        let layer = &font.glyphs.get("a").unwrap().layers[0];
+        let fs = |key: &str| layer.format_specific.get(key).and_then(|v| v.as_f64());
+        assert_eq!(fs("com.schriftgestalt.Glyphs.vertWidth"), Some(1000.0));
+        assert_eq!(fs("com.schriftgestalt.Glyphs.vertOrigin"), Some(200.0));
+    }
