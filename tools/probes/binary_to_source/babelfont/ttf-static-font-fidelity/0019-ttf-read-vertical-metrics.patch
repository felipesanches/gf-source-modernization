+/// A glyph's vmtx advance and origin, as Glyphs states them: vertWidth, and
+/// vertOrigin measured down from the typographic ascender. The origin is the top
+/// of the glyph's bounding box (0 for an empty glyph) plus its top side bearing.
+fn load_vertical_metrics(
+    fontref: &skrifa::FontRef<'_>,
+    gid: skrifa::GlyphId,
+    layer: &mut Layer,
+) -> Result<(), BabelfontError> {
+    let Ok(vmtx) = fontref.vmtx() else {
+        return Ok(());
+    };
+    let (Some(advance), Some(tsb)) = (vmtx.advance(gid), vmtx.side_bearing(gid)) else {
+        return Ok(());
+    };
+    let y_max = fontref
+        .loca(None)?
+        .get_glyf(gid, &fontref.glyf()?)?
+        .map_or(0, |glyph| glyph.y_max()) as f64;
+    let origin = y_max + tsb as f64;
+    let ascender = fontref.os2()?.s_typo_ascender() as f64;
+    layer.format_specific.insert(
+        "com.schriftgestalt.Glyphs.vertWidth".to_string(),
+        serde_json::json!(advance as f64),
+    );
+    layer.format_specific.insert(
+        "com.schriftgestalt.Glyphs.vertOrigin".to_string(),
+        serde_json::json!(ascender - origin),
+    );
+    Ok(())
+}
+
