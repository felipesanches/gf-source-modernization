+    fontref: &skrifa::FontRef<'_>,
+    glyf: &glyf::Glyf<'_>,
+    gid: skrifa::GlyphId,
+) -> Result<f64, BabelfontError> {
+    if fontref.loca(None)?.get_glyf(gid, glyf)?.is_none() {
+        return Ok(0.0);
+    }
+    drawn_shift(fontref, glyf, gid, 0)
 }
 
