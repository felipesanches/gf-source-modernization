                     .names
@@ -1052,18 +1047,47 @@ impl SfdParser {
                     .get("postscript_weight_name")
                     .and_then(|v| v.as_str()),
             );
+            // Name ID 2 of one of the four style-linked styles names the
+            // master when nothing else does: such a style has no typographic
+            // subfamily of its own.
+            if matches!(
+                derived.as_str(),
+                "Regular" | "Italic" | "Bold" | "Bold Italic" | "BoldItalic"
+            ) {
+                derived_style_linked = Some(derived.clone());
+            }
             self.font
                 .names
                 .preferred_subfamily_name
                 .set_default(derived);
         }
 
+        // Name ID 17 is the style within the typographic family; name ID 2 is
+        // the style within the style-linked family of name ID 1, which the
+        // style links to. ID 17 names the master when it links as ID 2 does.
+        let typographic_style = self
+            .font
+            .names
+            .typographic_subfamily
+            .get_default()
+            .filter(|style| {
+                self.font
+                    .names
+                    .preferred_subfamily_name
+                    .get_default()
+                    .is_some_and(|linked| style_link(style) == style_link(linked))
+            })
+            .cloned();
+        let stated_style = typographic_style.or(stated_style_linked);
+
         // Set master name based on width/weight
         if let Some(master) = self.font.masters.get_mut(0) {
             if let Some(style) = stated_style {
                 master.name = style.into();
             } else if let Some(style) = style_from_font_name {
                 master.name = style.into();
+            } else if let Some(style) = derived_style_linked {
+                master.name = style.into();
             } else if let Some(weight) = self.font.custom_ot_values.os2_us_weight_class {
                 let weight_name = crate::constants::OS2_WEIGHT_TO_NAME_MAP
                     .iter()
@@ -4008,6 +4032,22 @@ fn snap_matrix_entry(value: f64) -> f64 {
     }
 }
 
+/// The style-linked style (name ID 2) a style name links to: Regular, Italic,
+/// Bold or Bold Italic.
+fn style_link(style: &str) -> &'static str {
+    let style = style.replace(' ', "");
+    let (rest, italic) = match style.strip_suffix("Italic") {
+        Some(rest) => (rest, true),
+        None => (style.as_str(), false),
+    };
+    match (rest, italic) {
