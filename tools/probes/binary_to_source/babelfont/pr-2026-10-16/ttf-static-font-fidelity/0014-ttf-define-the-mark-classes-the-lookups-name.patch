From: =?UTF-8?q?Felipe=20Corr=C3=AAa=20da=20Silva=20Sanches?=
 <juca@members.fsf.org>
Date: Fri, 16 Oct 2026 08:33:59 +0100
Subject: [PATCH 14/18] ttf: define the mark classes the lookups name

GPOS mark classes became anchors, but the uncompiled mark lookups still named
them and nothing defined them, so the features did not compile. Now their
markClass statements are written too.

Assisted by an AI agent (Claude Opus 5.5)
---
 babelfont/src/convertors/ttf.rs | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/babelfont/src/convertors/ttf.rs b/babelfont/src/convertors/ttf.rs
index 8c22cf7a..15296e60 100644
--- a/babelfont/src/convertors/ttf.rs
+++ b/babelfont/src/convertors/ttf.rs
@@ -444,6 +444,13 @@ fn load_features(fontref: &skrifa::FontRef, font: &mut Font) -> Result<(), Babel
     }
 
     // Do the same but for mark classes.
+    // The lookups name the mark classes, so they are defined too
+    let mark_class_definitions = uncompile_context
+        .mark_classes
+        .values()
+        .flatten()
+        .map(|definition| definition.as_fea(""))
+        .join("\n");
     for (anchor_name, classdefs) in uncompile_context.mark_classes {
         let anchor_name = format!("_{}", anchor_name);
         for definition in classdefs.iter() {
@@ -506,6 +513,12 @@ fn load_features(fontref: &skrifa::FontRef, font: &mut Font) -> Result<(), Babel
             PossiblyAutomaticCode::new(language_systems_block),
         );
     }
+    if !mark_class_definitions.is_empty() {
+        features.prefixes.insert(
+            "MarkClasses".into(),
+            PossiblyAutomaticCode::new(mark_class_definitions),
+        );
+    }
     for (lookup_name, statements) in uncompile_context.lookups.iter() {
         features.prefixes.insert(
             lookup_name.clone(),
@@ -949,4 +962,22 @@ mod tests {
             .to_fea()
             .contains("= [a gravecomb acutecomb tildecomb f_f\n];"));
     }
+    #[test]
+    fn test_mark_classes_defined() {
+        // every mark class a lookup names has a markClass statement
+        let fea = load(GDEF_CLASSES).unwrap().features.to_fea();
+        let used: Vec<&str> = fea
+            .split("mark @")
+            .skip(1)
+            .map(|rest| {
+                rest.split(|c: char| c == ';' || c.is_whitespace())
+                    .next()
+                    .unwrap()
+            })
+            .collect();
+        assert!(!used.is_empty(), "{fea}");
+        for class in used {
+            assert!(fea.contains(&format!("> @{class};")), "@{class}: {fea}");
+        }
+    }
 }
