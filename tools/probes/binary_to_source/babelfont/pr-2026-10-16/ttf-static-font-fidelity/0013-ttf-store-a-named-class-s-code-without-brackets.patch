From: =?UTF-8?q?Felipe=20Corr=C3=AAa=20da=20Silva=20Sanches?=
 <juca@members.fsf.org>
Date: Fri, 16 Oct 2026 08:32:31 +0100
Subject: [PATCH 13/18] ttf: store a named class's code without brackets

A class's code is its member list and the writers add the brackets, so a class
read with them was written as @name = [[...]];, which does not parse. Now only
the members are stored.

Assisted by an AI agent (Claude Opus 5.5)
---
 babelfont/src/convertors/ttf.rs | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/babelfont/src/convertors/ttf.rs b/babelfont/src/convertors/ttf.rs
index 5bf91969..8c22cf7a 100644
--- a/babelfont/src/convertors/ttf.rs
+++ b/babelfont/src/convertors/ttf.rs
@@ -485,10 +485,11 @@ fn load_features(fontref: &skrifa::FontRef, font: &mut Font) -> Result<(), Babel
     }
 
     for (class_name, glyphs) in uncompile_context.named_classes.iter() {
-        features.classes.insert(
-            class_name.clone(),
-            PossiblyAutomaticCode::new(glyphs.as_fea("")),
-        );
+        // A class's code is its members; the writers add the brackets
+        let members = glyphs.glyphs.iter().map(|g| g.as_fea("")).join(" ");
+        features
+            .classes
+            .insert(class_name.clone(), PossiblyAutomaticCode::new(members));
     }
     let mut language_systems = vec![];
     for (script_tag, lang_sys_tags) in &uncompile_context.language_systems {
@@ -938,4 +939,14 @@ mod tests {
             .unwrap();
         assert_eq!(component.reference, "dupe.1");
     }
+    #[test]
+    fn test_named_class_members() {
+        let font = load(GDEF_CLASSES).unwrap();
+        let (_, members) = font.features.classes.first().unwrap();
+        assert_eq!(members.code, "a gravecomb acutecomb tildecomb f_f");
+        assert!(font
+            .features
+            .to_fea()
+            .contains("= [a gravecomb acutecomb tildecomb f_f\n];"));
+    }
 }
