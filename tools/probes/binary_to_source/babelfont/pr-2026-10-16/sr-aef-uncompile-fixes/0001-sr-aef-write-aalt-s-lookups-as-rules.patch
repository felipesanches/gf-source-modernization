 sr-aef/src/lib.rs         |  63 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 81 insertions(+)
 create mode 100644 sr-aef/resources/aalt.fea
 create mode 100644 sr-aef/resources/aalt.ttf

diff --git a/sr-aef/resources/aalt.fea b/sr-aef/resources/aalt.fea
new file mode 100644
index 00000000..381a7ad0
--- /dev/null
+++ b/sr-aef/resources/aalt.fea
@@ -0,0 +1,18 @@
+languagesystem DFLT dflt;
+
+lookup single {
+    sub a by a.alt1;
+} single;
+
+lookup alternate {
+    sub b from [b.alt1 b.alt2];
+} alternate;
+
+feature aalt {
+    lookup single;
+    lookup alternate;
+} aalt;
+
+feature salt {
+    lookup single;
+} salt;
